#!/usr/bin/env bash
# Print the newest release, optionally restricted to a version prefix:
#   latest-stable        -> 0.21.0
#   latest-stable 0.20   -> 0.20.1
set -euo pipefail

plugin_dir="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=../lib/utils.bash
. "$plugin_dir/lib/utils.bash"

query="${1:-}"
query="${query#v}"
versions="$(iyi_versions)"

if [ -n "$query" ]; then
  versions="$(printf '%s\n' "$versions" | awk -v q="$query" 'index($0, q) == 1')"
  [ -n "$versions" ] || exit 1
fi

printf '%s\n' "$versions" | tail -n 1
